-- フレンドリスト
local function updateFriendList()
    local success, result = pcall(function()
        return Players:GetFriendsAsync(LocalPlayer.UserId)
    end)
    if success and result then
        friendList = {}
        while true do
            local page = result:GetCurrentPage()
            for _, item in ipairs(page) do
                friendList[item.Id] = item.Username
            end
            if result.IsFinished then break end
            result:AdvanceToNextPageAsync()
        end
    end
end
updateFriendList()

local function isFriend(player)
    if not Config.friendProtect then return false end
    return friendList[player.UserId] ~= nil
end

