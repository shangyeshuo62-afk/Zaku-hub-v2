    task.wait(0.6)
    refreshPlayerList()
end)
Players.PlayerRemoving:Connect(function(plr)
    if selectedPlayerObj == plr then
        selectedPlayerObj = nil
        Notify("退出", plr.Name .. " が退出しました")
    end
    task.wait(0.3)
    refreshPlayerList()
end)

CombatGroup:AddToggle("KickSpam", {
    Text = "Kick Spam",
    Default = false,
    Callback = function(Value)
        Config.isActive = Value
        if Value then
            if not selectedPlayerObj then
                Notify("エラー", "先にターゲットを選択してください")
                task.wait()
                Library.Toggles.KickSpam:SetValue(false)
                return
            end
            if isFriend(selectedPlayerObj) then
                Notify("エラー", "フレンドは保護されています")
                Library.Toggles.KickSpam:SetValue(false)
                return
            end
            startLagSpam()
            task.spawn(function()
                while Config.isActive and selectedPlayerObj do
                    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if myRoot then
                        kickTarget(selectedPlayerObj, myRoot)
                    end
                    task.wait(0.001)
                end
            end)
            Notify("Kick Spam", "ON")
        else
            stopLagSpam()
            Notify("Kick Spam", "OFF")
        end
    end
})

CombatGroup:AddToggle("AllKick", {
    Text = "All Kick",
    Default = false,
    Callback = function(Value)
        Config.allActive = Value
        if Value then
            startLagSpam()
            task.spawn(function()
                while Config.allActive do
                    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if myRoot then
                        for _, v in ipairs(Players:GetPlayers()) do
                            if v ~= LocalPlayer and not isFriend(v) then
